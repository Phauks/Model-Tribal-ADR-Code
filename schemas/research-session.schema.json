{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Phauks/Tribal-Law-Project/schemas/research-session.schema.json",
  "title": "Research session (front matter)",
  "description": "YAML front matter of research/sessions/<yyyy>/<yyyy-mm-dd>-<topic>.md: how one research session was done and what it produced.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "date", "researchers", "tools", "purpose"],
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$", "description": "Equals the file name without .md." },
    "date": { "$ref": "common.schema.json#/$defs/calendarDate" },
    "researchers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "name"],
        "properties": {
          "kind": { "type": "string", "enum": ["web-search", "page-fetch", "legal-database", "library-database", "archive", "ai-assistant", "interview", "correspondence", "other"] },
          "name": { "type": "string", "description": "e.g. 'Westlaw', 'Wayback Machine', 'Claude (AI assistant)'." },
          "detail": { "type": "string" }
        }
      }
    },
    "purpose": { "type": "string" },
    "queries": { "type": "array", "items": { "type": "string" } },
    "sources_added": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/slug" }, "uniqueItems": true },
    "sources_updated": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/slug" }, "uniqueItems": true },
    "limits": { "type": "string", "description": "What was not checked, read only in part, or taken from search snippets." }
  }
}

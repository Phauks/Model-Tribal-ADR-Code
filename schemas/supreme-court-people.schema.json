{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Phauks/Tribal-Law-Project/schemas/supreme-court-people.schema.json",
  "title": "Supreme Court people",
  "description": "content/supreme-court/people.yaml: the Justices of the Supreme Court of the United States and the Presidents who appointed them, one entry per person, with a portrait where its license allows one. Generated by scripts/law/supreme_court_people.py from the Federal Judicial Center's Biographical Directory, the Library of Congress list of Presidents and Wikimedia Commons; the site reads it (site/src/lib/server/supreme-court-people.ts). scripts/validate_records.py checks that every seat and appointing President in justices.yaml is found here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources", "checked", "justices", "presidents"],
  "properties": {
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["biography", "presidents", "inaugurations"],
      "properties": {
        "biography": { "$ref": "common.schema.json#/$defs/slug" },
        "presidents": { "$ref": "common.schema.json#/$defs/slug" },
        "inaugurations": { "$ref": "common.schema.json#/$defs/slug" }
      }
    },
    "checked": { "$ref": "common.schema.json#/$defs/calendarDate" },
    "justices": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/justice" } },
    "presidents": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/president" } }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "date": { "$ref": "common.schema.json#/$defs/partialDate", "description": "The Directory gives only the year of birth of a living Justice." },
        "place": { "type": "string" }
      }
    },
    "justice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "directory", "directory_name", "born", "died", "education", "career", "appointments", "other_federal_service"],
      "properties": {
        "key": { "$ref": "common.schema.json#/$defs/slug", "description": "The person's address on the site, /supreme-court/justices/<key>." },
        "name": { "type": "string", "minLength": 1 },
        "directory": { "type": "string", "pattern": "^[0-9]+$", "description": "The Federal Judicial Center's number for the person." },
        "directory_name": { "type": "string", "minLength": 1 },
        "born": { "$ref": "#/$defs/event" },
        "died": { "anyOf": [{ "$ref": "#/$defs/event" }, { "type": "null" }], "description": "Empty (null) for a living Justice." },
        "education": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["school"],
            "properties": {
              "school": { "type": "string", "minLength": 1 },
              "degree": { "type": "string" },
              "year": { "type": "string", "pattern": "^[0-9]{4}$" }
            }
          }
        },
        "career": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "appointments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/appointment" } },
        "other_federal_service": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["court", "title"],
                "properties": {
                  "court": { "type": "string", "minLength": 1 },
                  "title": { "type": "string", "minLength": 1 },
                  "appointed_by": { "type": "string" },
                  "commissioned": { "$ref": "common.schema.json#/$defs/calendarDate" },
                  "ended": { "$ref": "common.schema.json#/$defs/calendarDate" },
                  "ending": { "type": "string" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["text"],
                "properties": { "text": { "type": "string", "minLength": 1, "description": "A line of service the Directory gives only as text." } }
              }
            ]
          }
        },
        "portrait": { "$ref": "#/$defs/portrait" }
      }
    },
    "appointment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seat", "title", "nominated", "senate_vote"],
      "properties": {
        "seat": { "type": "string", "pattern": "^SCT[0-9]{4}$", "description": "The seat, as in justices.yaml." },
        "title": { "type": "string", "enum": ["Chief Justice", "Associate Justice"] },
        "recess_appointment": { "$ref": "common.schema.json#/$defs/calendarDate" },
        "nominated": { "$ref": "common.schema.json#/$defs/calendarDate" },
        "hearing": { "$ref": "common.schema.json#/$defs/calendarDate" },
        "confirmed": { "$ref": "common.schema.json#/$defs/calendarDate" },
        "senate_vote": { "type": "string", "enum": ["Voice", "Roll Call", "Unknown"] },
        "ayes_nays": {
          "type": "string",
          "pattern": "^[0-9]+/[0-9]+$",
          "description": "The roll call, ayes/nays. The Directory gives John Rutledge's 1795 vote as 10//14; the generator reads a doubled slash as one (the Senate's record has 10-14)."
        },
        "commissioned": { "$ref": "common.schema.json#/$defs/calendarDate" },
        "party_of_president": { "type": "string" }
      }
    },
    "president": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "years", "party", "portrait"],
      "properties": {
        "key": { "$ref": "common.schema.json#/$defs/slug", "description": "The person's address on the site, /supreme-court/presidents/<key>." },
        "name": { "type": "string", "minLength": 1, "description": "As the Court's list gives it." },
        "years": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "prefixItems": [{ "type": "integer", "minimum": 1789 }, { "type": "integer", "minimum": 1789 }],
            "minItems": 2,
            "maxItems": 2
          },
          "description": "Years in office: [[1797, 1801]], or two runs for Grover Cleveland."
        },
        "serving_since": { "$ref": "common.schema.json#/$defs/calendarDate", "description": "The present term's start, when the Library of Congress list stops before it." },
        "party": { "type": ["string", "null"], "description": "Null for George Washington, who had no party." },
        "portrait": { "$ref": "#/$defs/portrait" }
      }
    },
    "portrait": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "page", "license", "attribution_required", "media_type", "width", "height", "key", "display_link"],
      "properties": {
        "file": { "type": "string", "minLength": 1, "description": "The file's name on Wikimedia Commons." },
        "page": { "type": "string", "pattern": "^https://commons\\.wikimedia\\.org/wiki/File:", "description": "The file's page on Commons, which records its source and license." },
        "artist": { "type": "string" },
        "credit": { "type": "string" },
        "date": { "type": "string" },
        "license": {
          "type": "string",
          "pattern": "^(Public domain|PD\\b.*|CC0|CC BY(-SA)? [0-9]\\.[0-9].*|CC BY(-SA)?)$",
          "description": "As Commons names it; only licenses that allow reuse (scripts/law/supreme_court_people.py, FREE_LICENSE)."
        },
        "license_link": { "$ref": "common.schema.json#/$defs/link" },
        "attribution_required": { "type": "boolean" },
        "media_type": { "type": "string", "enum": ["image/jpeg", "image/png"] },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "key": { "type": "string", "pattern": "^supreme-court/portraits/[a-z0-9]+(-[a-z0-9]+)*\\.(jpg|png)$", "description": "The private bucket's copy the site shows." },
        "display_link": { "type": "string", "pattern": "^https://upload\\.wikimedia\\.org/|^https://thumb\\.wikimedia\\.org/", "description": "Commons' copy at the size the site shows, used to fill the bucket." },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
      },
      "if": { "properties": { "attribution_required": { "const": true } } },
      "then": { "required": ["artist", "license_link"] }
    }
  }
}

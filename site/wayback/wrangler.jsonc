// Cloudflare Worker that saves source records' original links in the Wayback
// Machine with the project's archive.org keys (site/WAYBACK.md). The keys are
// secrets on this Worker, set in the Cloudflare dashboard, never in GitHub
// (decision record 0006).
//
// Workers Builds deploys it from the GitHub repository (root directory:
// site/wayback, build command: cd .. && npm ci, deploy command:
// npx wrangler deploy).
{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "tribal-law-project-wayback",
	"main": "worker.ts",
	"compatibility_date": "2026-11-20",
	// A public address for the read-only list of captures it has made, which
	// the archive workflow writes into the records. Nothing else is served.
	"workers_dev": true,
	"preview_urls": false,
	"observability": {
		"enabled": true
	},
	// Every minute: check on saves already asked for, then ask for a few more.
	"triggers": {
		"crons": ["* * * * *"]
	},
	// Its progress is one JSON object in the same private bucket as the site,
	// under wayback/.
	"r2_buckets": [
		{
			"binding": "sourceDocuments",
			"bucket_name": "tribal-law-project-files"
		}
	],
	// ARCHIVE_ORG_ACCESS_KEY and ARCHIVE_ORG_SECRET_KEY are Worker secrets (Settings >
	// Variables and Secrets), made at https://archive.org/account/s3.php. Only this
	// Worker uses them, so they are not in the account's Secrets Store.
}

{
	"name": "model-tribal-adr-code-site",
	"version": "0.0.1",
	"private": true,
	"description": "Website for the Model Tribal ADR Code, built with SvelteKit and served by a Cloudflare Worker.",
	"license": "MIT",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "npm run build && wrangler dev",
		"deploy": "npm run build && wrangler deploy",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:colors": "node tools/check-colors-come-from-tokens.mjs",
		"check:built-site": "node tools/check-built-site.mjs"
	},
	"devDependencies": {
		"@fontsource/atkinson-hyperlegible-next": "^5.3.0",
		"@fontsource/noto-sans": "^5.3.0",
		"@fontsource/noto-sans-canadian-aboriginal": "^5.3.0",
		"@fontsource/noto-sans-cherokee": "^5.3.0",
		"@fontsource/noto-sans-osage": "^5.3.0",
		"@sveltejs/adapter-cloudflare": "^9.0.0",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"marked": "^18.2.1",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"wrangler": "^4.166.0",
		"yaml": "^2.9.1"
	}
}

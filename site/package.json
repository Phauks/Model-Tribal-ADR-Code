{
	"name": "model-tribal-adr-code-site",
	"version": "0.0.1",
	"private": true,
	"description": "Website for the Model Tribal ADR Code, built with SvelteKit and served by a Cloudflare Worker.",
	"license": "MIT",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node tools/write-offline-sizes.mjs && node tools/add-scheduled-run.mjs",
		"preview": "npm run build && wrangler dev",
		"deploy": "npm run build && wrangler deploy",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"test": "vitest run",
		"check:colors": "node tools/check-colors-come-from-tokens.mjs",
		"check:motion": "node tools/check-motion-comes-from-tokens.mjs",
		"check:built-site": "node tools/check-built-site.mjs",
		"check:accessibility": "node tools/check-accessibility.mjs",
		"database:migrate:local": "wrangler d1 migrations apply database --local",
		"database:migrate:remote": "wrangler d1 migrations apply database --remote",
		"sign-in-link": "node tools/make-sign-in-link.mjs"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261121.1",
		"@fontsource/atkinson-hyperlegible-next": "^5.3.0",
		"@fontsource/noto-sans": "^5.3.0",
		"@fontsource/noto-sans-canadian-aboriginal": "^5.3.0",
		"@fontsource/noto-sans-cherokee": "^5.3.0",
		"@fontsource/noto-sans-osage": "^5.3.0",
		"@fontsource/noto-serif": "^5.3.0",
		"@fontsource/opendyslexic": "^5.3.0",
		"@lucide/svelte": "1.77.0",
		"@sveltejs/adapter-cloudflare": "^9.0.0",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/d3-geo": "^3.1.1",
		"@types/d3-path": "^3.1.1",
		"@types/geojson": "^7946.0.16",
		"@types/markdown-it": "^14.2.0",
		"@types/node": "^22.20.5",
		"@types/topojson-client": "^3.1.5",
		"@types/topojson-simplify": "^3.0.3",
		"@types/topojson-specification": "^1.0.5",
		"aws4fetch": "^1.0.20",
		"axe-core": "^4.14.1",
		"citeproc": "2.4.63",
		"d3-geo": "^3.1.2",
		"fflate": "^0.8.2",
		"lib0": "^0.2.120",
		"markdown-it": "^14.3.3",
		"markdown-it-container": "^4.0.0",
		"markdown-it-ins": "^4.0.0",
		"marked": "^18.2.1",
		"marked-footnote": "^1.4.0",
		"marked-gfm-heading-id": "^4.1.4",
		"playwright": "1.63.0",
		"pmtiles": "^4.5.0",
		"polylabel": "^2.1.0",
		"prosemirror-commands": "^1.7.2",
		"prosemirror-history": "^1.5.2",
		"prosemirror-inputrules": "^1.7.0",
		"prosemirror-keymap": "^1.2.3",
		"prosemirror-markdown": "^1.14.0",
		"prosemirror-model": "^1.25.13",
		"prosemirror-schema-list": "^1.6.1",
		"prosemirror-state": "^1.4.4",
		"prosemirror-view": "^1.43.0",
		"shapefile": "^0.6.6",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"topojson-client": "^3.1.0",
		"topojson-server": "^3.0.1",
		"topojson-simplify": "^3.0.3",
		"typescript": "^6.0.3",
		"us-atlas": "^3.0.1",
		"vite": "^8.3.8",
		"vitest": "^5.1.1",
		"wrangler": "^4.166.0",
		"y-prosemirror": "^1.3.7",
		"y-protocols": "^1.0.7",
		"y-websocket": "^3.1.0",
		"yaml": "^2.9.1",
		"yjs": "^13.6.33"
	}
}

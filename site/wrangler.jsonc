// Cloudflare Worker that serves the website.
//
// Workers Builds deploys it from the GitHub repository (root directory:
// site, build command: npm ci && npm run build, deploy command:
// npx wrangler deploy). No secret is stored in GitHub (decision record 0006).
//
// There is no "main" or "assets" setting here: @sveltejs/adapter-cloudflare
// sets the Worker entry and the static assets directory when it builds, and
// points Wrangler at the generated configuration.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "tribal-law-project-site",
	"compatibility_date": "2026-11-20",
	// The site's address is the project domain, triballawproject.org, a
	// Custom Domain of this Worker (Cloudflare makes its DNS record and
	// certificate). The workers.dev address is off, so there is one address
	// to cite; it was turned off in the dashboard on Nov. 25, 2026, and is
	// kept off here so a deploy does not turn it back on.
	"workers_dev": false,
	"routes": [{ "pattern": "triballawproject.org", "custom_domain": true }],
	// No version (preview) addresses. Each one runs that version's code
	// against the live database, buckets and email bindings, and every past
	// version keeps its address, so code with a problem fixed since would
	// still answer there. Nothing uses them: Workers Builds deploys only main.
	"preview_urls": false,
	"observability": {
		"enabled": true
	},
	// Code refers to these resources only by their binding names ("database"
	// and "sourceDocuments"). The resource names below can change, for
	// example when the project is renamed, without changing any code.
	//
	// Database for sign-in, co-author roles, reviews and requests from
	// nations. Its tables are created by the files in migrations/
	// (COLLABORATION.md, "Database"). A database identifier is not a secret.
	"d1_databases": [
		{
			"binding": "database",
			"database_name": "model-tribal-adr-code",
			"database_id": "2386ebd3-cea2-4ca1-9fff-0772fcd8bc6b",
			"migrations_dir": "migrations"
		},
		{
			// The source library (src/lib/server/source-library.ts): the text of
			// every document in the bucket, loaded from scripts/library/ and kept
			// up to date by the hourly run at minute 29.
			"binding": "sourceLibrary",
			"database_name": "model-tribal-adr-code-library",
			"database_id": "5ee18668-8141-400f-8f90-113f631a1734"
		}
	],
	// Private bucket for copies of source documents. Not public: nothing in
	// it is served unless the Worker chooses to serve it. Files sent with a
	// request are kept under requests/ and shown only to signed-in editors.
	"r2_buckets": [
		{
			"binding": "sourceDocuments",
			"bucket_name": "model-tribal-adr-code-sources"
		},
		// Private bucket for the project inbox (site/MAIL.md, "Storage"): each
		// message whole, its HTML and its attachments, under mail/. Kept apart
		// from the source documents so mail has its own access, lifecycle
		// rules and backups, and a mistake in one cannot touch the other.
		{
			"binding": "mailFiles",
			"bucket_name": "model-tribal-adr-code-mail"
		}
	],
	// Live editing rooms, one per essay. They run in their own Worker,
	// tribal-law-project-live (live/wrangler.jsonc), so that this site's
	// deploys do not close people's live connections (COLLABORATION.md,
	// "Essays").
	"durable_objects": {
		"bindings": [
			{
				"name": "essayRooms",
				"class_name": "EssayRoom",
				"script_name": "tribal-law-project-live"
			},
			// The virus scanner's desk (site/scanner). A sent file wakes it, so
			// the check starts at once instead of at its next minute round
			// (src/lib/server/scanner-wake.ts).
			{
				"name": "scanDesks",
				"class_name": "ScanDesk",
				"script_name": "tribal-law-project-scanner"
			}
		]
	},
	// The Wayback Worker (site/wayback), for its progress on the Service checks
	// page and the workspace's Wayback captures page. A Worker cannot fetch
	// another Worker's workers.dev address on the same account, so the site
	// reaches it through this binding (site/WAYBACK.md).
	"services": [
		{
			"binding": "waybackWorker",
			"service": "tribal-law-project-wayback"
		}
	],
	// Limits how often one address can send the request form: five a minute
	// is plenty for a person and slows down automated spam, without asking
	// anyone to make an account or solve a puzzle (docs/requests.md).
	"ratelimits": [
		{
			"name": "requestFormLimit",
			"namespace_id": "1001",
			"simple": { "limit": 5, "period": 60 }
		},
		// Limits how many changes one signed-in person can make in a minute
		// in the workspace (keyed by the person, not the address), so a stolen
		// session or a runaway script cannot rewrite much before someone
		// notices. Thirty a minute is far more than a person clicking needs.
		// Refused page views count against it too, so they cannot flood the
		// activity log (COLLABORATION.md, "Protection against unauthorized
		// changes").
		{
			"name": "workspaceChangeLimit",
			"namespace_id": "1002",
			"simple": { "limit": 30, "period": 60 }
		},
		// Limits sign-in tries for each email address: five a minute for each
		// step (asking for a code, typing a code, typing a password), so codes
		// and passwords cannot be guessed by trying many quickly
		// (COLLABORATION.md, "How sign-in works").
		{
			"name": "signInLimit",
			"namespace_id": "1003",
			"simple": { "limit": 5, "period": 60 }
		},
		// And for each network address, more loosely, because a whole office
		// or tribal government building can share one address.
		{
			"name": "signInNetworkLimit",
			"namespace_id": "1004",
			"simple": { "limit": 30, "period": 60 }
		},
		// Guards against a runaway script: how many files one account can
		// start sending, or YouTube links it can add, in a minute
		// (docs/uploads.md). The pieces of a file are not counted, and the
		// upload page waits and carries on when it is reached, so people
		// never see it as a limit (decision record 0038, "Limits").
		{
			"name": "uploadLimit",
			"namespace_id": "1005",
			"simple": { "limit": 600, "period": 60 }
		}
	],
	// Cloudflare Email Service, for sign-in codes. It sends only from a domain
	// onboarded in Email Service on this Cloudflare account; the address is
	// SIGN_IN_EMAIL_FROM below. While that is empty, the site sends no email
	// and people sign in with a password or a link from the lead author
	// (COLLABORATION.md, "Setting up sign-in").
	//
	// The second binding sends summaries of updates to pages readers follow,
	// from UPDATE_EMAIL_FROM. That address is the switch for those emails:
	// while it is empty, nothing is sent and readers see notices on the site
	// only. Set it once the domain is onboarded (docs/domain-to-do.md;
	// COLLABORATION.md, "Following pages"). SITE_ADDRESS is the site's public
	// address, for the links in those emails and in the project inbox's
	// unsubscribe links. The build also reads the published site text from it
	// (src/lib/server/site-text-build.ts), so it must be an address that answers.
	//
	// The third, projectEmail, sends replies from the project inbox
	// (site/MAIL.md). It sends only mail people started: replies, and the
	// inbox's own "new mail" notice. Outreach goes through a separate
	// mailbox's SMTP server (the OUTREACH_ settings), because Cloudflare's
	// terms do not allow unsolicited mail.
	"send_email": [{ "name": "signInEmail" }, { "name": "updateEmail" }, { "name": "projectEmail" }],
	"vars": {
		"SIGN_IN_EMAIL_FROM": "",
		"UPDATE_EMAIL_FROM": "",
		"SITE_ADDRESS": "https://triballawproject.org",
		// The project inbox (site/MAIL.md, "Switching email on"). While
		// MAIL_DOMAIN is empty, the inbox pages open but no mail is received
		// or sent. MAIL_SIGNING_KEY and OUTREACH_SMTP_PASSWORD are Secrets set
		// in the dashboard, never here.
		"MAIL_DOMAIN": "",
		"MAIL_NOTICE_ADDRESS": "",
		"MAIL_SENDER_NAME": "Model Tribal ADR Code",
		"OUTREACH_CARRIER": "",
		"OUTREACH_FROM": "",
		"OUTREACH_REPLY_TO": "",
		"OUTREACH_SMTP_HOST": "",
		"OUTREACH_SMTP_PORT": "465",
		"OUTREACH_SMTP_USERNAME": "",
		// The video rooms' Cloudflare account and RealtimeKit app (COLLABORATION.md,
		// "The video room"). Neither is a secret. Naming them here means the room
		// needs no lookup with its token, which can only reach RealtimeKit and so
		// cannot list the account (the live room failed that way on Nov. 23, 2026).
		// The token itself, VIDEO_ROOM_TOKEN, is a Secret set in the dashboard.
		"VIDEO_ROOM_ACCOUNT": "b7902f2098c6d8cd1ac5910fc5373fee",
		"VIDEO_ROOM_APPLICATION": "97ccdd98-f20c-46c8-b0cd-c34aa6934c50"
	},
	// Every hour, at 17 minutes past: find updates to followed pages and send
	// the summary emails that are due. Mondays at 09:41 UTC: check the private
	// address book against the federal and Alaska directories and the nation
	// pages (COLLABORATION.md, "Address book"). Every 15 minutes: move event
	// waitlists along and send event confirmations and reminders
	// (COLLABORATION.md, "Events"). tools/add-scheduled-run.mjs adds the
	// Worker's scheduled handler after the build, since the SvelteKit adapter
	// makes only a fetch handler.
	//
	// Every five minutes: the project inbox's run (scheduled messages, snoozed
	// conversations, outreach pacing, emptying Deleted after 30 days). It
	// does nothing while MAIL_DOMAIN is empty. tools/add-mail-handlers.mjs
	// runs last in the build, takes this cron, and passes every other one to
	// the scheduled handler above.
	"triggers": {
		"crons": ["17 * * * *", "41 9 * * 1", "4,19,34,49 * * * *", "*/5 * * * *"]
	}
	// The queue consumer for delivery events from Cloudflare Email Service is
	// added when email is switched on, because a deploy fails while the
	// queue does not exist yet (site/MAIL.md, "Delivery reports").
	//
	// Some settings are made in the Cloudflare dashboard (Worker > Settings >
	// Variables and Secrets) rather than here, because this file is public,
	// each added as the Secret type so that deploys keep it (plain-text
	// dashboard variables are replaced by this file on each deploy):
	// LEAD_AUTHOR_EMAIL, the first lead author's address (COLLABORATION.md,
	// "Setting up sign-in"); MAIL_SIGNING_KEY, which signs unsubscribe links;
	// and OUTREACH_SMTP_PASSWORD, the outreach mailbox's app password
	// (MAIL.md, "Switching email on").
}

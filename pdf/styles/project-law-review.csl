<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="note" version="1.0" demote-non-dropping-particle="sort-only" default-locale="en-US">
  <info>
    <title>Bluebook Law Review (Model Tribal ADR Code edition)</title>
    <id>https://github.com/Phauks/Model-Tribal-ADR-Code/pdf/styles/project-law-review.csl</id>
    <link href="https://github.com/Phauks/Model-Tribal-ADR-Code/blob/main/pdf/styles/project-law-review.csl" rel="self"/>
    <link href="http://www.zotero.org/styles/bluebook-law-review" rel="template"/>
    <link href="https://law.resource.org/pub/us/code/blue/indigobook-2.1.html" rel="documentation"/>
    <link href="https://www.legalbluebook.com/" rel="documentation"/>
    <author>
      <name>Bruce D'Arcus</name>
      <email>bdarcus@gmail.com</email>
    </author>
    <author>
      <name>Nancy Sims</name>
      <email>nsims@umich.edu</email>
    </author>
    <contributor>
      <name>Patrick O'Brien</name>
    </contributor>
    <contributor>
      <name>Timothy Magill</name>
    </contributor>
    <contributor>
      <name>Shay Elbaum</name>
      <email>selbaum@law.harvard.edu</email>
    </contributor>
    <category citation-format="note"/>
    <category field="law"/>
    <summary>The Bluebook legal citation style for law reviews, modified by the Model Tribal ADR Code project so that statutes and uniform acts keep their section pinpoints and have a short form (Indigo Book R16.2, R17.5, R18.4, R22.2). Changes are listed in pdf/styles/README.md.</summary>
    <updated>2026-11-21T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale>
    <terms>
      <term name="editor" form="verb-short">ed.</term>
      <term name="ibid">id.</term>
      <term name="translator" form="verb-short">trans.</term>
    </terms>
  </locale>
  <macro name="name-macro">
    <names variable="author">
      <name and="symbol" delimiter=", " delimiter-precedes-last="never"/>
      <label form="short" prefix=" "/>
    </names>
  </macro>
  <macro name="author-short">
    <choose>
      <if type="legal_case">
        <choose>
          <if variable="title-short">
            <text macro="name-short-macro" font-style="italic"/>
          </if>
          <else>
            <text macro="name-short-macro"/>
          </else>
        </choose>
      </if>
      <else-if type="bill legislation" match="any">
        <text macro="name-macro"/>
      </else-if>
      <else-if type="book graphic motion_picture report song" match="any">
        <text macro="name-short-macro" font-variant="small-caps"/>
      </else-if>
      <else>
        <text macro="name-short-macro"/>
      </else>
    </choose>
  </macro>
  <macro name="name-short-macro">
    <names variable="author">
      <name form="short" and="text" delimiter=", "/>
      <substitute>
        <text variable="title" form="short"/>
      </substitute>
    </names>
  </macro>
  <macro name="author">
    <choose>
      <if type="legal_case legislation" match="any">
        <!-- legal cases do not display the author at the beginning of the line -->
      </if>
      <else-if type="bill" match="any">
        <text macro="name-macro"/>
      </else-if>
      <else-if type="book graphic motion_picture report song" match="any">
        <text macro="name-macro" font-variant="small-caps"/>
      </else-if>
      <else>
        <text macro="name-macro"/>
      </else>
    </choose>
  </macro>
  <macro name="editor-translator">
    <names variable="editor translator" delimiter=", ">
      <name and="symbol" delimiter=", "/>
      <label form="short" strip-periods="false" prefix=" "/>
    </names>
  </macro>
  <!-- Model Tribal ADR Code: pinpoints. A page pinpoint reads "at 52"; any other
       label prints its symbol or short form: "§ 4", "§§ 4-6", "¶ 3". Indigo Book
       (2d ed. 2023) R6.2.2: do not use "at" before a section or paragraph pinpoint. -->
  <macro name="pinpoint">
    <choose>
      <if locator="page">
        <group delimiter=" ">
          <text value="at"/>
          <text variable="locator"/>
        </group>
      </if>
      <else>
        <group delimiter=" ">
          <label variable="locator" form="symbol"/>
          <text variable="locator"/>
        </group>
      </else>
    </choose>
  </macro>
  <!-- Pinpoint inside a full citation: a page is the bare number ("49, 52"). -->
  <macro name="full-pinpoint">
    <choose>
      <if locator="page">
        <text variable="locator"/>
      </if>
      <else>
        <text macro="pinpoint"/>
      </else>
    </choose>
  </macro>
  <!-- Model Tribal ADR Code: a section of a code, "25 U.S.C. § 5130(2)".
       The pinpoint is a subdivision of the section and is joined to it
       (Indigo Book R16.1, R16.2, R22.2). The section variable arrives with its
       symbol, "§ 5130" or "§§ 654–658": the build adds it, because CSL
       cannot tell that "§§ 38.206–38.248" is plural (pdf/pipeline/citations.mjs).
       The code's abbreviation is container-title-short when the record has one. -->
  <macro name="code-section">
    <group delimiter=" ">
      <text variable="volume"/>
      <text variable="container-title" form="short"/>
      <group>
        <text variable="section"/>
        <text variable="locator"/>
      </group>
    </group>
  </macro>
  <!-- Model Tribal ADR Code: a whole act cited by name, "Unif. Mediation Act § 4"
       (Indigo Book R16.2, R18.4). Put the abbreviated name in title-short. -->
  <macro name="named-act">
    <choose>
      <if variable="number">
        <group delimiter=", ">
          <text variable="title" form="short"/>
          <text variable="number"/>
          <text macro="pinpoint"/>
        </group>
      </if>
      <else>
        <group delimiter=" ">
          <text variable="title" form="short"/>
          <text macro="pinpoint"/>
        </group>
      </else>
    </choose>
  </macro>
  <!-- Model Tribal ADR Code: a document in the Federal Register, cited by its
       volume and first page, "Exec. Order 12,988, 61 Fed. Reg. 4729" (Indigo
       Book R19.4 and the executive order entry in its agency table). A page
       pinpoint follows the first page: "61 Fed. Reg. 4729, 4731". Used for a
       legislation record with volume and page but no section; put "Fed. Reg."
       in container-title-short. -->
  <macro name="register-document">
    <group delimiter=", ">
      <text variable="title" form="short"/>
      <group delimiter=" ">
        <text variable="volume"/>
        <text variable="container-title" form="short"/>
        <text variable="page-first"/>
      </group>
      <text macro="full-pinpoint"/>
    </group>
  </macro>
  <!-- Model Tribal ADR Code: "(Unif. L. Comm'n 2001)", "(West 2021)", "(2018)",
       "(repealed 2015)" (Indigo Book R16.1.5, R17.3, R17.4, R18.4). -->
  <macro name="legislation-parenthetical">
    <group delimiter=" " prefix="(" suffix=")">
      <choose>
        <if variable="status">
          <text variable="status"/>
        </if>
        <else>
          <text variable="authority"/>
          <text variable="publisher"/>
        </else>
      </choose>
      <choose>
        <!-- Model Tribal ADR Code: a Federal Register document gives its full
             date, "(Feb. 5, 1996)" (Indigo Book R19.4). -->
        <if variable="section" match="none">
          <choose>
            <if variable="volume page" match="all">
              <date variable="issued">
                <date-part name="month" form="short" suffix=" "/>
                <date-part name="day" suffix=", "/>
                <date-part name="year"/>
              </date>
            </if>
            <else>
              <date variable="issued">
                <date-part name="year"/>
              </date>
            </else>
          </choose>
        </if>
        <else>
          <date variable="issued">
            <date-part name="year"/>
          </date>
        </else>
      </choose>
    </group>
  </macro>
  <macro name="legislation-short">
    <choose>
      <if variable="section">
        <text macro="code-section"/>
      </if>
      <else-if variable="volume page" match="all">
        <text macro="register-document"/>
      </else-if>
      <else>
        <text macro="named-act"/>
      </else>
    </choose>
  </macro>
  <macro name="access">
    <choose>
      <if type="legal_case legislation" match="any">
        <!-- legal case citations generally do not use URL's -->
      </if>
      <else-if variable="URL">
        <group delimiter=" ">
          <text variable="URL"/>
          <choose>
            <if variable="issued" match="none">
              <group delimiter=" " prefix="(" suffix=")">
                <text value="last visited"/>
                <date variable="accessed">
                  <date-part name="month" form="short" suffix=" "/>
                  <date-part name="day" suffix=", "/>
                  <date-part name="year"/>
                </date>
              </group>
            </if>
          </choose>
        </group>
      </else-if>
    </choose>
  </macro>
  <macro name="source">
    <choose>
      <if type="article-journal" match="any">
        <group delimiter=" ">
          <group delimiter=", ">
            <text variable="title" text-case="title" font-style="italic"/>
            <group delimiter=" ">
              <text variable="volume"/>
              <text macro="container"/>
              <text variable="page-first"/>
            </group>
            <text macro="full-pinpoint"/>
          </group>
          <text macro="issuance" prefix="(" suffix=")"/>
        </group>
      </if>
      <else-if type="legal_case">
        <!-- Model Tribal ADR Code: case names in italics (Indigo Book R10.1). A
             case with no reporter is cited by its docket number and full date,
             "No. 2017-1620 (Fed. Cir. June 13, 2017)" (Indigo Book R10.1.6). -->
        <choose>
          <if variable="container-title">
            <group delimiter=" ">
              <group delimiter=", ">
                <text variable="title" text-case="title" font-style="italic"/>
                <text variable="volume"/>
              </group>
              <text macro="container"/>
              <group delimiter=", ">
                <text variable="page-first"/>
                <text macro="full-pinpoint"/>
              </group>
              <text macro="issuance" prefix="(" suffix=")"/>
            </group>
          </if>
          <else>
            <group delimiter=" ">
              <group delimiter=", ">
                <text variable="title" text-case="title" font-style="italic"/>
                <text variable="number"/>
                <text macro="full-pinpoint"/>
              </group>
              <group delimiter=" " prefix="(" suffix=")">
                <text variable="authority"/>
                <date variable="issued">
                  <date-part name="month" form="short" suffix=" "/>
                  <date-part name="day" suffix=", "/>
                  <date-part name="year"/>
                </date>
              </group>
            </group>
          </else>
        </choose>
      </else-if>
      <else-if type="legislation">
        <!-- Model Tribal ADR Code: keeps the pinpoint and adds the parenthetical. -->
        <group delimiter=" ">
          <text macro="legislation-short"/>
          <text macro="legislation-parenthetical"/>
        </group>
      </else-if>
      <else-if type="article-newspaper article-magazine" match="any">
        <group delimiter=", ">
          <text variable="title" text-case="title" font-style="italic"/>
          <group delimiter=" ">
            <text variable="volume"/>
            <text macro="container"/>
          </group>
          <text macro="issuance"/>
          <group delimiter=" ">
            <text value="at"/>
            <text variable="page-first"/>
          </group>
        </group>
      </else-if>
      <else-if type="article thesis" match="any">
        <group delimiter=", ">
          <text variable="title" text-case="title"/>
          <text macro="container"/>
        </group>
        <text macro="issuance" prefix=" (" suffix=")"/>
        <choose>
          <if type="thesis">
            <group delimiter=", " prefix=" (" suffix=")">
              <text variable="genre" suffix=" dissertation"/>
              <text variable="publisher"/>
            </group>
          </if>
        </choose>
      </else-if>
      <else-if type="chapter paper-conference" match="any">
        <text variable="title" text-case="title" font-style="italic"/>
        <group prefix=", " delimiter=" " suffix=" ">
          <text variable="volume"/>
          <text macro="container"/>
        </group>
        <text variable="page-first"/>
        <text macro="full-pinpoint" prefix=", "/>
        <text macro="issuance" prefix=" (" suffix=")"/>
      </else-if>
      <else-if type="book report" match="any">
        <text variable="title" text-case="title" font-variant="small-caps"/>
        <text macro="full-pinpoint" prefix=" "/>
        <text macro="issuance" prefix=" (" suffix=")"/>
      </else-if>
      <else>
        <group delimiter=", ">
          <text variable="title" text-case="title" font-style="italic"/>
          <group delimiter=" ">
            <text variable="volume"/>
            <text macro="container"/>
            <text variable="page-first"/>
            <text macro="full-pinpoint"/>
            <text macro="issuance" prefix="(" suffix=")"/>
          </group>
        </group>
      </else>
    </choose>
  </macro>
  <macro name="issuance">
    <choose>
      <if match="any" variable="status">
        <group delimiter=" ">
          <text variable="status" text-case="capitalize-first"/>
          <date variable="issued">
            <date-part name="year"/>
          </date>
        </group>
      </if>
      <else>
        <choose>
          <if type="article article-journal article-magazine article-newspaper broadcast interview manuscript map patent personal_communication song speech thesis webpage post-weblog" match="any">
            <group>
              <choose>
                <if type="article article-newspaper thesis webpage post-weblog" match="any">
                  <group>
                    <date variable="issued">
                      <date-part name="month" form="short" suffix=" "/>
                      <date-part name="day" prefix=" " suffix=", "/>
                    </date>
                  </group>
                </if>
                <else-if type="article-magazine">
                  <date variable="issued">
                    <date-part name="month" suffix=" " form="short"/>
                  </date>
                </else-if>
              </choose>
              <date variable="issued">
                <date-part name="year"/>
              </date>
            </group>
          </if>
          <else-if type="legal_case">
            <group delimiter=" ">
              <text variable="authority"/>
              <date variable="issued">
                <date-part name="year"/>
              </date>
            </group>
          </else-if>
          <else>
            <group delimiter=", ">
              <text macro="editor-translator"/>
              <group delimiter=" ">
                <group delimiter=" ">
                  <text variable="edition"/>
                  <label variable="edition" form="short"/>
                </group>
                <date variable="issued">
                  <date-part name="year"/>
                </date>
              </group>
            </group>
          </else>
        </choose>
      </else>
    </choose>
  </macro>
  <macro name="container">
    <choose>
      <if type="chapter paper-conference" match="any">
        <group>
          <text term="in" font-style="italic" prefix=" "/>
          <text variable="container-title" font-variant="small-caps" prefix=" "/>
        </group>
      </if>
      <else-if type="legal_case">
        <text variable="container-title" form="short" prefix=" "/>
      </else-if>
      <else-if type="legislation">
        <text variable="container-title"/>
      </else-if>
      <else-if type="article-journal">
        <text variable="container-title" form="short" font-variant="small-caps" prefix=" "/>
      </else-if>
      <else>
        <text variable="container-title" font-variant="small-caps"/>
      </else>
    </choose>
  </macro>
  <citation et-al-min="4" et-al-use-first="1">
    <layout suffix="." delimiter="; ">
      <choose>
        <if position="ibid-with-locator">
          <group delimiter=" ">
            <text term="ibid" text-case="capitalize-first" font-style="italic"/>
            <choose>
              <!-- Model Tribal ADR Code: "Id. § 5130(3)" (Indigo Book R22.2) -->
              <if type="legislation" variable="section" match="all">
                <group>
                  <text variable="section"/>
                  <text variable="locator"/>
                </group>
              </if>
              <else>
                <text macro="pinpoint"/>
              </else>
            </choose>
          </group>
        </if>
        <else-if position="ibid">
          <text term="ibid" text-case="capitalize-first" font-style="italic"/>
        </else-if>
        <else-if position="subsequent">
          <choose>
            <!-- subsequent legal citations do not use supra -->
            <if type="legal_case">
              <group delimiter=", ">
                <text variable="title" form="short" font-style="italic"/>
                <group delimiter=" ">
                  <text variable="volume"/>
                  <text variable="container-title" form="short"/>
                  <text macro="pinpoint"/>
                </group>
              </group>
            </if>
            <else-if type="legislation">
              <!-- Model Tribal ADR Code: no supra for statutes (Indigo Book R6.2.3) -->
              <text macro="legislation-short"/>
            </else-if>
            <else>
              <group delimiter=", ">
                <group delimiter=" ">
                  <choose>
                    <if type="book" match="any">
                      <text variable="volume"/>
                    </if>
                  </choose>
                  <text macro="author-short"/>
                </group>
                <!-- Model Tribal ADR Code: "Vats, supra note 5, at 100" (Indigo Book R6.2.3) -->
                <group delimiter=", ">
                  <group delimiter=" ">
                    <text value="supra" font-style="italic"/>
                    <text value="note"/>
                    <text variable="first-reference-note-number"/>
                  </group>
                  <text macro="pinpoint"/>
                </group>
              </group>
            </else>
          </choose>
        </else-if>
        <else>
          <group delimiter=", ">
            <group delimiter=" ">
              <choose>
                <if type="book" match="any">
                  <text variable="volume"/>
                </if>
              </choose>
              <text macro="author"/>
            </group>
            <text macro="source"/>
            <text macro="access"/>
          </group>
        </else>
      </choose>
    </layout>
  </citation>
</style>
